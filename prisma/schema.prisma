generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  password           String
  role               String   @default("USER")
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  allowPlayerLinking Boolean  @default(false)
  showEmailInSearch  Boolean  @default(false)
  games              Game[]
  players            Player[]
  linkedPlayers      Player[] @relation("LinkedPlayer")
  playLogs           PlayLog[]
  plannedGameNights  PlannedGameNight[]
  inboxMessages      InboxMessage[]
  sentJoinRequests   InboxMessage[] @relation("JoinRequester")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SiteSettings {
  id                String   @id @default(cuid())
  allowRegistration Boolean  @default(true)
  inviteOnlyMode    Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  createdBy   String
  usedBy      String?  @unique
  usedAt      DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([code])
  @@index([isActive])
  @@index([createdBy])
}

model Game {
  id              String   @id @default(cuid())
  bggId           Int      @unique
  title           String
  thumbnail       String?
  image           String?
  minPlayers      Int
  maxPlayers      Int
  minPlayTime     Int?
  maxPlayTime     Int?
  yearPublished   Int?
  description     String?
  mechanics       String
  categories      String
  designers       String
  publishers      String
  artists         String   @default("")
  minAge          Int?
  complexity      Float?
  bggRating       Float?
  bggRatingsCount Int?
  bggRank         Int?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playLogs        PlayLog[]
  plannedGames    PlannedGame[]
  createdAt       DateTime @default(now())
}

model Player {
  id                String   @id @default(cuid())
  name              String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedUserId      String?
  linkedUser        User?    @relation("LinkedPlayer", fields: [linkedUserId], references: [id], onDelete: SetNull)
  playLogs          PlayLog[] @relation("PlayLogPlayers")
  wins              PlayLog[] @relation("PlayLogWinners")
  plannedGameNights PlannedGameNight[] @relation("PlannedGameNightPlayers")
  playerResponses   PlayerResponse[]
  gameVotes         GameVote[]
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@unique([name, userId])
  @@index([userId])
  @@index([linkedUserId])
}

model PlayLog {
  id          String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playedAt    DateTime @default(now())
  players     Player[] @relation("PlayLogPlayers")
  winners     Player[] @relation("PlayLogWinners")
  duration    Int?
  location    String?
  rating      Int?
  notes       String?
  createdAt   DateTime @default(now())
  
  @@index([gameId])
  @@index([userId])
  @@index([playedAt])
}

model PlannedGameNight {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedAt       DateTime @default(now())
  eventDateTime   DateTime?
  location        String?
  games           PlannedGame[]
  players         Player[]    @relation("PlannedGameNightPlayers")
  inboxMessages   InboxMessage[]
  
  // Invite link fields
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  inviteEnabled   Boolean   @default(false)
  
  // RSVP tracking
  playerResponses PlayerResponse[]
  gameVotes       GameVote[]
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([plannedAt])
  @@index([inviteToken])
}

model PlannedGame {
  id                String   @id @default(cuid())
  plannedNightId    String
  plannedNight      PlannedGameNight @relation(fields: [plannedNightId], references: [id], onDelete: Cascade)
  gameId            String
  game              Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  youtubeVideoId    String?
  youtubeVideoTitle String?
  youtubeVideoUrl   String?
  order             Int
  votes             GameVote[]

  @@index([plannedNightId])
  @@index([gameId])
}

model PlayerResponse {
  id              String   @id @default(cuid())
  plannedNightId  String
  plannedNight    PlannedGameNight @relation(fields: [plannedNightId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status          String   // "coming", "not_coming", "maybe"
  respondedAt     DateTime @default(now())

  @@unique([plannedNightId, playerId])
  @@index([plannedNightId])
  @@index([playerId])
}

model GameVote {
  id              String   @id @default(cuid())
  plannedNightId  String
  plannedNight    PlannedGameNight @relation(fields: [plannedNightId], references: [id], onDelete: Cascade)
  plannedGameId   String
  plannedGame     PlannedGame @relation(fields: [plannedGameId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  votedAt         DateTime @default(now())

  @@unique([plannedNightId, plannedGameId, playerId])
  @@index([plannedNightId])
  @@index([plannedGameId])
  @@index([playerId])
}

model ManualEditTracking {
  id           String   @id @default(cuid())
  gameId       String   @unique
  userId       String
  editedFields String   // JSON array of field names
  editedAt     DateTime @default(now())
  
  @@index([userId])
  @@index([gameId])
}

model BulkUpdateSession {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   // 'preview', 'running', 'paused', 'completed', 'failed', 'cancelled'
  
  totalGames      Int
  processed       Int      @default(0)
  autoMatched     Int      @default(0)
  manualApproved  Int      @default(0)
  skipped         Int      @default(0)
  failed          Int      @default(0)
  
  overwriteManual Boolean
  retryStrategy   String   @default("skip") // 'retry' or 'skip'
  currentGameId   String?
  currentGameTitle String?
  
  beforeData      String?  // JSON
  afterData       String?  // JSON
  manualEditGames String?  // JSON
  skippedGames    String?  // JSON
  failedGames     String?  // JSON
  
  consecutiveFailures Int      @default(0)
  pauseReason         String?
  rateLimitExpiry     DateTime?
  
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  lastActivityAt  DateTime @default(now())
  
  @@index([userId])
  @@index([status])
}

model InboxMessage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // "BGN_INVITE", "JOIN_REQUEST", "JOIN_RESPONSE"
  title           String
  message         String
  plannedNightId  String?
  plannedNight    PlannedGameNight? @relation(fields: [plannedNightId], references: [id], onDelete: Cascade)
  inviteToken     String?
  senderName      String
  eventDateTime   DateTime?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  // Join request fields
  requesterId     String?
  requester       User?    @relation("JoinRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  responseType    String?  // "ACCEPTED" or "DECLINED"
  joinRequestId   String?  // Link to original request (for responses)
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([eventDateTime])
  @@index([requesterId])
}