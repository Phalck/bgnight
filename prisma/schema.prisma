generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  password           String
  role               String   @default("USER")
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  games              Game[]
  players            Player[]
  playLogs           PlayLog[]
  plannedGameNights  PlannedGameNight[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SiteSettings {
  id                String   @id @default(cuid())
  allowRegistration Boolean  @default(true)
  inviteOnlyMode    Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  createdBy   String
  usedBy      String?  @unique
  usedAt      DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([code])
  @@index([isActive])
  @@index([createdBy])
}

model Game {
  id              String   @id @default(cuid())
  bggId           Int      @unique
  title           String
  thumbnail       String?
  image           String?
  minPlayers      Int
  maxPlayers      Int
  minPlayTime     Int?
  maxPlayTime     Int?
  yearPublished   Int?
  description     String?
  mechanics       String
  categories      String
  designers       String
  publishers      String
  artists         String   @default("")
  minAge          Int?
  complexity      Float?
  bggRating       Float?
  bggRatingsCount Int?
  bggRank         Int?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playLogs        PlayLog[]
  plannedGames    PlannedGame[]
  createdAt       DateTime @default(now())
}

model Player {
  id                String   @id @default(cuid())
  name              String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playLogs          PlayLog[] @relation("PlayLogPlayers")
  wins              PlayLog[] @relation("PlayLogWinners")
  plannedGameNights PlannedGameNight[] @relation("PlannedGameNightPlayers")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  
  @@unique([name, userId])
  @@index([userId])
}

model PlayLog {
  id          String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playedAt    DateTime @default(now())
  players     Player[] @relation("PlayLogPlayers")
  winners     Player[] @relation("PlayLogWinners")
  duration    Int?
  location    String?
  rating      Int?
  notes       String?
  createdAt   DateTime @default(now())
  
  @@index([gameId])
  @@index([userId])
  @@index([playedAt])
}

model PlannedGameNight {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedAt     DateTime @default(now())
  eventDateTime DateTime?
  location      String?
  customMessage String?
  games         PlannedGame[]
  players       Player[]    @relation("PlannedGameNightPlayers")
  createdAt     DateTime @default(now())
  
  @@index([userId])
  @@index([plannedAt])
}

model PlannedGame {
  id                String   @id @default(cuid())
  plannedNightId    String
  plannedNight      PlannedGameNight @relation(fields: [plannedNightId], references: [id], onDelete: Cascade)
  gameId            String
  game              Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  youtubeVideoId    String?
  youtubeVideoTitle String?
  youtubeVideoUrl   String?
  order             Int
  
  @@index([plannedNightId])
  @@index([gameId])
}

model ManualEditTracking {
  id           String   @id @default(cuid())
  gameId       String   @unique
  userId       String
  editedFields String   // JSON array of field names
  editedAt     DateTime @default(now())
  
  @@index([userId])
  @@index([gameId])
}

model BulkUpdateSession {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   // 'preview', 'running', 'paused', 'completed', 'failed', 'cancelled'
  
  totalGames      Int
  processed       Int      @default(0)
  autoMatched     Int      @default(0)
  manualApproved  Int      @default(0)
  skipped         Int      @default(0)
  failed          Int      @default(0)
  
  overwriteManual Boolean
  retryStrategy   String   @default("skip") // 'retry' or 'skip'
  currentGameId   String?
  
  beforeData      String?  // JSON
  afterData       String?  // JSON
  manualEditGames String?  // JSON
  skippedGames    String?  // JSON
  failedGames     String?  // JSON
  
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  lastActivityAt  DateTime @default(now())
  
  @@index([userId])
  @@index([status])
}